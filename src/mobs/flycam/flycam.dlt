##############################
# Simple Game — Flycam
# Camera-only entity: state + spawn
##############################

struct FlycamState:
    camera:     Node = Node()
    move_speed: f32  = 14.0
    fast_mult:  f32  = 3.0
    yaw:        f32  = 0.0
    pitch:      f32  = 0.0

fun spawn_flycam(app: App, flycam: FlycamState, x: f32, y: f32, z: f32) -> void:
    flycam.camera = app.spawn<Camera>()
        .set_name("FlyCam")
        .set_fov(75.0)
        .position(x, y, z)
    flycam.move_speed = 14.0
    flycam.fast_mult = 3.0
    flycam.yaw = 0.0
    flycam.pitch = 0.0
    flycam.camera.rotation(flycam.pitch, flycam.yaw, 0.0)
