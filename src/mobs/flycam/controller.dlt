##############################
# Simple Game — Flycam Controller
# Free camera movement + mouse look
##############################

fun update_flycam(app: App, flycam: FlycamState, dt: f32) -> void:
    move_speed: f32 = flycam.move_speed
    if app.key_down(KeyCode.Shift):
        move_speed = move_speed * flycam.fast_mult
    speed: f32 = move_speed * dt
    px: f32 = flycam.camera.pos_x()
    py: f32 = flycam.camera.pos_y()
    pz: f32 = flycam.camera.pos_z()

    # Mouse capture toggle
    if app.key_pressed(KeyCode.Escape):
        app.mouse_release()
    if app.mouse_captured() == 0:
        if app.key_pressed(KeyCode.M):
            app.mouse_capture()

    # Camera rotation - mouse when captured, arrow keys as fallback
    if app.mouse_captured():
        mx: f32 = app.mouse_dx()
        my: f32 = app.mouse_dy()
        flycam.yaw = flycam.yaw - mx * 0.15
        flycam.pitch = flycam.pitch - my * 0.15
    else:
        if app.key_down(KeyCode.Left):
            flycam.yaw = flycam.yaw + 90.0 * dt
        if app.key_down(KeyCode.Right):
            flycam.yaw = flycam.yaw - 90.0 * dt
        if app.key_down(KeyCode.Up):
            flycam.pitch = flycam.pitch + 90.0 * dt
        if app.key_down(KeyCode.Down):
            flycam.pitch = flycam.pitch - 90.0 * dt

    if flycam.pitch > 89.0:
        flycam.pitch = 89.0
    if flycam.pitch < 0.0 - 89.0:
        flycam.pitch = 0.0 - 89.0

    # Direction vectors
    pi: f32 = 3.14159265
    yaw_rad: f32 = flycam.yaw * pi / 180.0
    fwd_x: f32 = 0.0 - @sin(yaw_rad)
    fwd_z: f32 = 0.0 - @cos(yaw_rad)
    right_x: f32 = @cos(yaw_rad)
    right_z: f32 = 0.0 - @sin(yaw_rad)

    # WASD movement + vertical flight
    dx: f32 = 0.0
    dy: f32 = 0.0
    dz: f32 = 0.0
    if app.key_down(KeyCode.W):
        dx = dx + fwd_x * speed
        dz = dz + fwd_z * speed
    if app.key_down(KeyCode.S):
        dx = dx - fwd_x * speed
        dz = dz - fwd_z * speed
    if app.key_down(KeyCode.A):
        dx = dx - right_x * speed
        dz = dz - right_z * speed
    if app.key_down(KeyCode.D):
        dx = dx + right_x * speed
        dz = dz + right_z * speed
    if app.key_down(KeyCode.Space):
        dy = dy + speed
    if app.key_down(KeyCode.E):
        dy = dy + speed
    if app.key_down(KeyCode.Ctrl):
        dy = dy - speed
    if app.key_down(KeyCode.Q):
        dy = dy - speed

    flycam.camera.position(px + dx, py + dy, pz + dz)
    flycam.camera.rotation(flycam.pitch, flycam.yaw, 0.0)
