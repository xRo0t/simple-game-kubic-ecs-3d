##############################
# Simple Game — Player Controller
# Input handling, movement, camera
##############################

fun update_player(app: App, player: PlayerState, dt: f32) -> void:
    speed: f32 = player.move_speed * dt
    px: f32 = player.body.pos_x()
    py: f32 = player.body.pos_y()
    pz: f32 = player.body.pos_z()

    # Mouse capture toggle
    if app.key_pressed(KeyCode.Escape):
        app.mouse_release()
    if app.mouse_captured() == 0:
        if app.key_pressed(KeyCode.M):
            app.mouse_capture()

    # Camera rotation — mouse when captured, arrow keys as fallback
    if app.mouse_captured():
        mx: f32 = app.mouse_dx()
        my: f32 = app.mouse_dy()
        player.yaw = player.yaw - mx * 0.15
        player.pitch = player.pitch - my * 0.15
        if player.pitch > 89.0:
            player.pitch = 89.0
        if player.pitch < 0.0 - 89.0:
            player.pitch = 0.0 - 89.0
    else:
        if app.key_down(KeyCode.Left):
            player.yaw = player.yaw + 90.0 * dt
        if app.key_down(KeyCode.Right):
            player.yaw = player.yaw - 90.0 * dt

    # Direction vectors
    pi: f32 = 3.14159265
    yaw_rad: f32 = player.yaw * pi / 180.0
    fwd_x: f32 = 0.0 - @sin(yaw_rad)
    fwd_z: f32 = 0.0 - @cos(yaw_rad)
    right_x: f32 = @cos(yaw_rad)
    right_z: f32 = 0.0 - @sin(yaw_rad)

    # WASD movement
    dx: f32 = 0.0
    dz: f32 = 0.0
    if app.key_down(KeyCode.W):
        dx = dx + fwd_x * speed
        dz = dz + fwd_z * speed
    if app.key_down(KeyCode.S):
        dx = dx - fwd_x * speed
        dz = dz - fwd_z * speed
    if app.key_down(KeyCode.A):
        dx = dx - right_x * speed
        dz = dz - right_z * speed
    if app.key_down(KeyCode.D):
        dx = dx + right_x * speed
        dz = dz + right_z * speed

    # Apply movement
    px = px + dx
    pz = pz + dz
    player.body.position(px, py, pz)

    # First-person camera (eye height 1.0)
    player.camera.position(px, py + 1.0, pz)
    player.camera.rotation(player.pitch, player.yaw, 0.0)
