##############################
# Simple Game — Player
# PlayerState struct + spawn
##############################

struct PlayerState:
    body:       Node = Node()
    camera:     Node = Node()
    move_speed: f32  = 5.0
    yaw:        f32  = 0.0
    pitch:      f32  = 0.0

fun spawn_player(app: App, player: PlayerState, x: f32, y: f32, z: f32) -> void:
    player.body = app.spawn<Cube>()
        .set_name("Player")
        .scale(0.8, 0.8, 0.8)
        .position(x, y, z)
    player.camera = app.spawn<Camera>()
        .set_name("PlayerCam")
        .set_fov(75.0)
        .position(x, y + 1.6, z)
    player.move_speed = 5.0
    player.pitch = 0.0
    player.camera.rotation(0.0, 0.0, 0.0)
