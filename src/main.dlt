##############################
# Simple Game — Kobic ECS 3D
#
# A first-person world: a free-flying camera, thousands of social
# goblins, and ambient critters — all running data-oriented update
# loops over a flat entity array.
#
# `App` hides every piece of engine plumbing: window creation, the
# Vulkan context, swapchain, render pass, renderer, the ECS scene,
# input binding, and frame timing. Game entities are `Node` handles.
##############################
import kobic
# import mobs.player.player
# import mobs.player.controller
import mobs.flycam.flycam
import mobs.flycam.controller
import mobs.goblin.goblin
import mobs.goblin.controller
import mobs.critter.critter
import mobs.critter.controller
import world.earth

# ---- Setup ----
# App.new bundles Window + VulkanContext + Swapchain + RenderPass +
# Renderer + Scene + input binding behind a single handle. The
# six-object juggling the old main.dlt did by hand is gone.
app: App = App.new("Simple Game - Kobic Engine", 800, 600)

earth:    EarthState   = EarthState()
goblins:  GoblinState  = GoblinState()
critters: CritterState = CritterState()
spawn_world(app, earth, goblins, critters)

flycam: FlycamState = FlycamState()
spawn_flycam(app, flycam, 0.0, 10.5, 0.0)

print("Scene ready")

# ---- Game loop — explicit, every step visible ----
pi:      f32 = 3.14159265
dt:      f32 = 0.0
cam_x:   f32 = 0.0
cam_z:   f32 = 0.0
yaw_rad: f32 = 0.0
fwd_x:   f32 = 0.0
fwd_z:   f32 = 0.0 - 1.0

while app.running():
    # begin_frame: poll OS events, refresh keyboard + mouse state, and
    # return the delta time (seconds) since the previous frame.
    dt = app.begin_frame()

    update_flycam(app, flycam, dt)

    # The goblins flee from the camera — hand their AI its position and
    # facing so they can react to where the player is looking.
    cam_x   = flycam.camera.pos_x()
    cam_z   = flycam.camera.pos_z()
    yaw_rad = flycam.yaw * pi / 180.0
    fwd_x   = 0.0 - @sin(yaw_rad)
    fwd_z   = 0.0 - @cos(yaw_rad)

    update_goblins(goblins, dt, cam_x, cam_z, fwd_x, fwd_z)
    update_critters(critters, dt)

    # end_frame: rebuild moved transforms, render from the active
    # camera, and present the frame.
    app.end_frame()

# ---- Cleanup ----
cleanup_goblins(goblins)
cleanup_critters(critters)
app.shutdown()        # destroys Vulkan objects + window
print("Game closed")
