print("=== Files in current directory ===")
listing: str = System.Command.capture("cmd /c dir /b")

# اطبع كل سطر مع رقم
i: i32 = 1
line_start: i64 = 0
total_len: i64 = Memory.strlen(listing)
pos: i64 = 0

while pos < total_len:
    ch: i32 = Memory.read_i8((listing as i64) + pos) as i32
    if ch == 10:  # newline
        # طباعة السطر مع رقمه
        print(Convert.i32_to_str(i) + ". " + Str.substring(listing, line_start, pos))
        i = i + 1
        line_start = pos + 1
    pos = pos + 1

